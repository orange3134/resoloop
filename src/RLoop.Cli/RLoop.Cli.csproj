<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>rloop</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rloop</ToolCommandName>
    <PackageId>RLoop.Cli</PackageId>
    <Version>0.1.0</Version>
    <Description>Agent-first CLI loop for Resonite development through ResoniteLink and Flux-SDK.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RLoop.Core/RLoop.Core.csproj" />
    <ProjectReference Include="../RLoop.ResoniteLink/RLoop.ResoniteLink.csproj" />
    <ProjectReference Include="../RLoop.Flux/RLoop.Flux.csproj" />
    <ProjectReference Include="../RLoop.Flux.Deployer/RLoop.Flux.Deployer.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../docs/QUICKSTART.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
