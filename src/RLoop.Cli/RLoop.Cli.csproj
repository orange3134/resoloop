<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>resoloop</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>resoloop</ToolCommandName>
    <PackageId>ResoLoop</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Title>ResoLoop</Title>
    <Authors>orange3134</Authors>
    <Description>Agent-first CLI loop for Resonite development through ResoniteLink and Flux-SDK.</Description>
    <PackageTags>resonite;resonitelink;protoflux;flux-sdk;cli;ai-agent</PackageTags>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/orange3134/resoloop</PackageProjectUrl>
    <RepositoryUrl>https://github.com/orange3134/resoloop.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RLoop.Core/RLoop.Core.csproj" />
    <ProjectReference Include="../RLoop.ResoniteLink/RLoop.ResoniteLink.csproj" />
    <ProjectReference Include="../RLoop.Flux/RLoop.Flux.csproj" />
    <ProjectReference Include="../RLoop.Flux.Deployer/RLoop.Flux.Deployer.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
    <None Include="../../docs/QUICKSTART.md" Pack="true" PackagePath="docs/" />
    <None Include="../../src/**/*"
          Exclude="../../src/**/bin/**/*;../../src/**/obj/**/*"
          Pack="true"
          PackagePath="source/src/" />
    <None Include="../../skills/codex/**/*" Pack="true" PackagePath="source/skills/codex/" />
    <None Include="../../Directory.Build.props;../../Directory.Packages.props;../../global.json;../../NuGet.Config;../../ResoLoop.slnx"
          Pack="true"
          PackagePath="source/" />
  </ItemGroup>
</Project>
