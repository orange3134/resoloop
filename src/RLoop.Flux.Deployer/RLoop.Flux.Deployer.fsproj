    <PackageReference Include="FParsec" />
    <PackageReference Include="FSharp.Data.Json.Core" />
    <PackageReference Include="Papaltine.ResoniteLink.RPath" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../RLoop.Core/RLoop.Core.csproj" />
  </ItemGroup>
</Project>
