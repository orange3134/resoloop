  "tests": [
    {
      "name": "Expired deadline",
      "probe": {
        "kind": "set-member",
        "target": "$member:close-at.Value",
        "value": 0,
        "safe": true,
        "restore": true
      },
      "assertions": [
        {
          "target": "$member:open-state.Value",
          "expected": false,
          "phase": "after"
        },
        {
          "target": "$member:readout-text.Content",
          "expected": "CLOSED",
          "phase": "after"
        },
        {
          "target": "$member:door-position.State",
          "expected": false,
          "phase": "after"
        }
      ]
    },
    {
      "name": "Future deadline",
      "probe": {
        "kind": "set-member",
        "target": "$member:close-at.Value",
        "value": 1000000000000.0,
        "safe": true,
        "restore": true
      },
      "assertions": [
        {
          "target": "$member:open-state.Value",
          "expected": true,
          "phase": "after"
        },
        {
          "target": "$member:readout-text.Content",
          "expected": "OPEN",
          "phase": "after"
        },
        {
          "target": "$member:door-position.State",
          "expected": true,
          "phase": "after"
        }
      ]
    }
