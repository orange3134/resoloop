  "tests": [
    {
      "name": "Stopped simulation resets local velocity",
      "probe": {
        "kind": "set-member",
        "target": "$member:running.Value",
        "value": false,
        "safe": true,
        "restore": true
      },
      "assertions": [
        {
          "target": "$member:velocity.Value",
          "expected": 0,
          "phase": "after"
        },
        {
          "target": "$member:run-label-text.Content",
          "expected": "START",
          "phase": "after"
        }
      ]
    }
