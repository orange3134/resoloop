              0.15,
              0.15,
              0.15,
              1
            ],
            "Metallic": 0,
            "Smoothness": 0.35
          }
        }
      ]
    },
    {
      "slot": {
        "key": "lamp",
        "name": "Lamp",
        "position": [
          0.85,
          0.1,
          0
