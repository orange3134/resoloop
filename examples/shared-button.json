{
  "schemaVersion": "1",
  "ownership": {
    "key": "shared-button-study"
  },
  "slot": {
    "key": "root",
    "name": "ResoLoop_Example_SharedButton",
    "parent": "Root",
    "position": [
      2.0,
      1.4,
      1.8
    ]
  },
  "children": [
    {
      "slot": {
