            "OffsetUnits": 100
          }
        }
      ]
    },
    {
      "slot": {
        "key": "rear-material-slot",
        "name": "Rear material"
      },
      "components": [
        {
          "key": "rear-material",
          "type": "FrooxEngine.UI_UnlitMaterial",
          "fields": {
            "Sidedness": "Back",
            "ZWrite": "On",
            "ZTest": "LessOrEqual",
            "OffsetFactor": 1,
            "OffsetUnits": 100
          }
        }
      ]
    },
    {
      "slot": {
        "key": "lamp-material-slot",
        "name": "Lamp material"
      },
      "components": [
        {
          "key": "lamp-material",
          "type": "FrooxEngine.PBS_Metallic",
          "fields": {
