{
  "include": [
    "house/materials.json",
    "house/scene.json"
  ],
  "schemaVersion": "1",
  "ownership": {
    "key": "house-world"
  },
  "parameters": {},
  "slot": {
    "key": "root",
    "name": "ResoLoop_Test_HouseWorld",
    "parent": "Root",
    "position": [
      8.5,
      0,
      5.5
    ],
    "scale": [
      1,
      1,
      1
    ]
  },
  "cameras": {
    "main": {
      "position": [
        0,
        3.2,
        -9.5
      ],
      "target": [
        0,
        1.2,
        0
      ],
      "fieldOfView": 58,
      "width": 1280,
      "height": 720,
      "output": "artifacts/house-main.svg",
      "representative": true
    }
  },
  "tests": [
    {
      "name": "mirror-toggle-wiring",
      "assertions": [
        {
          "target": "$component:mirrorToggle.TargetValue",
          "expected": "$member:mirrorRenderer.Enabled"
        },
        {
          "target": "$component:mirrorRenderer.Enabled",
          "exists": true
        },
        {
          "target": "$component:mirrorRenderer.Enabled",
          "expected": false,
          "phase": "after"
        }
      ],
      "probe": {
        "target": "$component:mirrorTouch",
        "method": "Press",
        "safe": true
      },
      "timeoutMs": 2000,
      "pollMs": 100
    }
  ]
}
